{
  "name": "@hydrochlorix/googledrive-mcp-server",
  "version": "2.4.0",
  "description": "Model Context Protocol (MCP) server for Google Drive API",
  "keywords": ["mcp", "mcp-server", "google-drive", "least-privilege-key", "adc"],
  "homepage": "https://github.com/HydroChlorix/googledrive-mcp-server#readme",
  "bugs": {
    "url": "https://github.com/HydroChlorix/googledrive-mcp-server/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HydroChlorix/googledrive-mcp-server.git"
  },
  "license": "MIT",
  "type": "module",
  "main": "dist/server.mjs",
  "types": "dist/server.d.ts",
  "bin": {
    "googledrive-mcp-server": "dist/server.mjs"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "engines": {
    "node": ">=20.0.0",
    "npm": "<11.10.0 || >=11.12.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "dev": "npm run build:ui && tsx watch src/index.ts",
    "build:ui": "node scripts/build-ui.mjs",
    "build": "npm run build:ui && vite build",
    "start": "node dist/server.mjs",
    "test": "vitest run",
    "test:all": "npm run lint && npm run build && npm test && npm run test:dashboard",
    "test:unit": "vitest run --exclude tests/integration/**",
    "test:dashboard": "vitest run tests/audit/ tests/cli.test.ts",
    "test:logger": "vitest run tests/operationLogger.test.ts",
    "test:smoke": "vitest run tests/integration/mcp-smoke.test.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check . && tsc --noEmit && npm run lint:md",
    "lint:fix": "biome check --write",
    "lint:unsafe": "biome check --write --unsafe",
    "lint:md": "markdownlint '**/*.md' --ignore node_modules --ignore dist --ignore tmp",
    "lint:md:fix": "markdownlint '**/*.md' --fix --ignore node_modules --ignore dist --ignore tmp",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "clean:port": "npx kill-port 3001 || true",
    "inspector": "npx @modelcontextprotocol/inspector node dist/server.mjs",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "googleapis": "^173.0.0",
    "hono": "^4.13.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.8.3",
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20.14.10",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.28.2",
    "husky": "^9.0.11",
    "markdownlint-cli": "^0.49.1",
    "tsx": "^4.16.2",
    "typescript": "^7.0.2",
    "vite": "^6.4.3",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "@biomejs/biome": true,
    "esbuild": true
  }
}
