# Mandatory application boundary
GOOGLE_DRIVE_SHARED_DRIVE_ID=<SHARED_DRIVE_ID>

# Optional narrower boundary inside the Shared Drive
GOOGLE_DRIVE_ROOT_FOLDER_ID=<ROOT_FOLDER_ID>

# Optional Operational Mode ("readonly" or "readwrite", default: readwrite)
GOOGLE_DRIVE_MODE=readwrite

# Optional Service Account Key authentication (ADR-0011 for Headless/Server environments)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# Optional Audit & Governance Dashboard Configuration
MCP_DASHBOARD_ENABLED=true
MCP_DASHBOARD_PORT=3001
MCP_DASHBOARD_TOKEN=<CUSTOM_TOKEN>
# TRUST_PROXY=false
